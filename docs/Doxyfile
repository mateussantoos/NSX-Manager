# Doxygen configuration for NSX Manager.
#
# The two settings that matter are EXTRACT_ALL = NO and WARN_AS_ERROR:
# together they make an undocumented public entity FAIL THE BUILD.
#
# That is deliberate. The predecessor has a commit titled "add comprehensive
# Doxygen international documentation across all headers and source files"
# which produced doc comments, no Doxyfile, no build and no output. Nothing
# was ever verified, and the comments rotted. Documentation that is not built
# is not documentation.
#
# Run:  cd docs && doxygen Doxyfile      (output: ../build/docs/html)

PROJECT_NAME           = "NSX Manager"
PROJECT_BRIEF          = "On-console manager for Nintendo Switch custom firmware and homebrew"
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = ../build/docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# ---------------------------------------------------------------------------
# Input
# ---------------------------------------------------------------------------
INPUT                  = ../src/nsx \
                         ../apps/forwarder/src \
                         api-mainpage.md
FILE_PATTERNS          = *.cpp *.hpp *.h *.md
RECURSIVE              = YES
EXCLUDE                = ../third_party \
                         ../apps/rcm-payload \
                         ../build
EXCLUDE_PATTERNS       = */detail/* */build/*
EXCLUDE_SYMBOLS        = *::detail::*
USE_MDFILE_AS_MAINPAGE = api-mainpage.md
MARKDOWN_SUPPORT       = YES

# ---------------------------------------------------------------------------
# Extraction - the gate
# ---------------------------------------------------------------------------
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# ---------------------------------------------------------------------------
# Warnings - the enforcement
# ---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_FORMAT            = "$file:$line: $text"

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES
SEPARATE_MEMBER_PAGES  = NO
TAB_SIZE               = 4
OPTIMIZE_OUTPUT_FOR_C  = NO
BUILTIN_STL_SUPPORT    = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
GENERATE_TODOLIST      = YES
GENERATE_BUGLIST       = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

# ---------------------------------------------------------------------------
# Diagrams - collaboration graphs only. Call graphs on a codebase this size
# are noise, and they roughly triple the build time.
# ---------------------------------------------------------------------------
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DIRECTORY_GRAPH        = YES
DOT_GRAPH_MAX_NODES    = 60

# ---------------------------------------------------------------------------
# Preprocessing - so the generated version header does not break extraction
# ---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = __SWITCH__ \
                         DOXYGEN_SHOULD_SKIP_THIS \
                         "NSX_HANDOFF_PATH=\"\""

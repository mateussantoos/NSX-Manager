# https://editorconfig.org - the single place that fixes encoding and line endings.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{c,cc,cpp,h,hpp,in}]
indent_size = 4

[*.{json,yml,yaml,js}]
indent_size = 2

[*.py]
indent_size = 4

[*.{md,markdown}]
indent_size = 2
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

[*.pem]
insert_final_newline = false
trim_trailing_whitespace = false

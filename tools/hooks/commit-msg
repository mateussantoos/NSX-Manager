#!/bin/sh
# Conventional Commits validation - POSIX sh, no dependencies.
#
# A C++ repository must not require `npm install` before you can commit, so the
# local enforcer is this script and CI's enforcer is commitlint. Both read
# tools/hooks/scopes.txt, so they cannot disagree about what a valid scope is.
#
# Install:  tools/hooks/install.sh
# Bypass:   git commit --no-verify   (CI will still reject it - see ci.yml)
# SPDX-License-Identifier: GPL-3.0-only

set -eu

MSG_FILE="$1"
REPO_ROOT="$(git rev-parse --show-toplevel)"
SCOPES_FILE="$REPO_ROOT/tools/hooks/scopes.txt"

TYPES='feat|fix|perf|refactor|docs|style|test|build|ci|chore|revert'
MAX_HEADER=72

die() {
    printf '\n\033[31mcommit-msg: %s\033[0m\n' "$1" >&2
    shift
    for line in "$@"; do printf '  %s\n' "$line" >&2; done
    printf '\n  Format: <type>(<scope>): <subject>\n' >&2
    printf '  Types:  %s\n' "$(echo "$TYPES" | tr '|' ' ')" >&2
    printf '  Scopes: see tools/hooks/scopes.txt\n' >&2
    printf '  Docs:   docs/contributing/commit-convention.md\n\n' >&2
    exit 1
}

# First non-comment, non-blank line is the header.
HEADER="$(grep -v '^#' "$MSG_FILE" | grep -v '^[[:space:]]*$' | head -n 1 || true)"

[ -n "$HEADER" ] || die "empty commit message"

# Merge, revert and fixup commits are generated by git; let them through.
case "$HEADER" in
    "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

# --- shape -----------------------------------------------------------------
if ! printf '%s' "$HEADER" | grep -Eq "^($TYPES)(\([a-z0-9/-]+\))?!?: .+"; then
    die "header does not match the Conventional Commits format" \
        "got: $HEADER"
fi

TYPE="$(printf '%s' "$HEADER" | sed -E 's/^([a-z]+).*/\1/')"
SCOPE="$(printf '%s' "$HEADER" | sed -nE 's/^[a-z]+\(([a-z0-9/-]+)\).*/\1/p')"
SUBJECT="$(printf '%s' "$HEADER" | sed -E 's/^[a-z]+(\([a-z0-9/-]+\))?!?: //')"

# --- length ----------------------------------------------------------------
LEN="$(printf '%s' "$HEADER" | wc -c | tr -d ' ')"
[ "$LEN" -le "$MAX_HEADER" ] || \
    die "header is $LEN characters, limit is $MAX_HEADER" "got: $HEADER"

# --- English-only proxy: the header must be ASCII ---------------------------
if printf '%s' "$HEADER" | LC_ALL=C grep -q '[^ -~]'; then
    die "header contains non-ASCII characters (this project commits in English)" \
        "got: $HEADER"
fi

# --- scope -----------------------------------------------------------------
# Required for changes that alter behaviour; optional for housekeeping types.
case "$TYPE" in
    feat|fix|perf|refactor)
        [ -n "$SCOPE" ] || die "a scope is required for '$TYPE'" \
            "e.g. $TYPE(semver): ..." "got: $HEADER"
        ;;
esac

if [ -n "$SCOPE" ]; then
    if [ ! -f "$SCOPES_FILE" ]; then
        die "scope list not found at $SCOPES_FILE"
    fi
    # A slash-separated compound scope like ui/tabs is valid when every part is.
    OLD_IFS="$IFS"; IFS='/'
    for part in $SCOPE; do
        if ! grep -v '^#' "$SCOPES_FILE" | grep -qx "$part"; then
            IFS="$OLD_IFS"
            die "unknown scope '$part'" \
                "add it to tools/hooks/scopes.txt in this commit, or pick an existing one" \
                "got: $HEADER"
        fi
    done
    IFS="$OLD_IFS"
fi

# --- subject ---------------------------------------------------------------
case "$SUBJECT" in
    *.) die "subject must not end with a period" "got: $HEADER" ;;
esac

FIRST="$(printf '%s' "$SUBJECT" | cut -c1)"
case "$FIRST" in
    [A-Z]) die "subject must start lowercase" "got: $HEADER" ;;
esac

# --- breaking changes ------------------------------------------------------
# Require BOTH markers so neither a human skimming the log nor git-cliff can
# miss one.
if printf '%s' "$HEADER" | grep -q '!:'; then
    grep -q '^BREAKING CHANGE: ' "$MSG_FILE" || \
        die "'!' marks a breaking change, so a 'BREAKING CHANGE: ' footer is required" \
            "describe what breaks and how to migrate"
fi

exit 0
